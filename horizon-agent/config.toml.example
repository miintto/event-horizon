# horizon-agent configuration. Copy this to config.toml and fill in the values for deployment.
# config.toml contains a secret (api_key), so it must not be committed.

server_url = "http://localhost:8000"
api_key = "xxxxx"

# All values below are optional; defaults are applied when omitted.
# collect_interval_secs = 10
# send_interval_secs = 60
# agent_id_path = "/var/lib/horizon-agent/agent_id"
# disk_path = "/"
# http_timeout_secs = 10
# max_buffer_size = 2880
